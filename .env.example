# ===================================================
# ShopEase Environment Configuration Template
# ===================================================

# Server Port
PORT=8080

# Database Configuration (H2)
# Production / Server Mode: jdbc:h2:tcp://localhost:9092/./data/shopease;DB_CLOSE_DELAY=-1
# Embedded Persistent Mode: jdbc:h2:file:./data/shopease;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
# In-Memory Test Mode: jdbc:h2:mem:shopease_test;DB_CLOSE_DELAY=-1;MODE=LEGACY
DB_URL=jdbc:h2:file:./data/shopease;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USER=sa
DB_PASSWORD=

# HikariCP Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_TIMEOUT_MS=30000

# Session Configuration (Seconds - 1800s = 30 minutes)
SESSION_TIMEOUT_SECONDS=1800

# AI Chatbot Configuration
# Options: 'mock' (default, offline FAQ-aware) or 'gemini' (requires GEMINI_API_KEY)
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
AI_CHATBOT_MODEL=gemini-1.5-flash

# Logging Level
LOG_LEVEL=INFO
